{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "./scripts/run-dev.sh",
    "assets:android": "node scripts/generate-android-assets.mjs",
    "assets:ios": "node scripts/generate-ios-assets.mjs",
    "landing:dev": "nuxt dev apps/landing --dotenv .env.development --host localhost --port 3001",
    "landing:dev:network": "nuxt dev apps/landing --dotenv .env.development --host 0.0.0.0 --port 3001",
    "landing:build": "nuxt build apps/landing",
    "landing:generate": "nuxt generate apps/landing",
    "landing:preview": "nuxt preview apps/landing --port 3001",
    "dev:redis:up": "./scripts/start-redis.sh",
    "dev:redis:down": "docker compose -f docker-compose.dev.yml down redis",
    "dev:redis:logs": "docker compose -f docker-compose.dev.yml logs -f redis",
    "dev:redis:restart": "docker compose -f docker-compose.dev.yml restart redis",
    "dev:redis:check": "docker compose -f docker-compose.dev.yml exec -T redis redis-cli ping 2>/dev/null || redis-cli ping 2>/dev/null || echo '❌ Redis не запущен. Запусти: pnpm dev:redis:up или brew services start redis'",
    "dev:redis:stop-brew": "brew services stop redis 2>/dev/null || echo '⚠️  Redis не запущен через brew или brew недоступен'",
    "generate": "nuxt generate --dotenv .env.development",
    "generate:dev": "nuxt generate --dotenv .env.development",
    "generate:prod": "nuxt generate --dotenv .env.production",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "media:check": "node scripts/check-media-hashes.mjs",
    "hash:meditation-images": "node scripts/hash-meditation-images.mjs",
    "db:update-meditation-image-paths": "tsx server/infrastructure/db/update-meditation-image-paths.ts",
    "media:publish": "pnpm hash:meditation-images && pnpm db:update-meditation-image-paths && pnpm upload:media",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "prepare": "husky",
    "db:generate": "tsx scripts/db/generate.ts",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:cleanup-slots-duplicates": "tsx scripts/db/cleanup-notification-slot-duplicates.ts",
    "db:sync-notification-templates": "tsx scripts/migrate-templates-to-db.ts",
    "db:reset-billing-credit-nonprod": "tsx scripts/db/reset-billing-credit-nonprod.ts",
    "db:baseline": "tsx scripts/db/baseline.ts",
    "seed:subscription-plans": "tsx server/infrastructure/db/seed-subscription-plans.ts",
    "seed:meditations": "tsx server/infrastructure/db/seed-meditations.ts",
    "seed:required": "tsx scripts/seed-required.ts",
    "verify:schema": "tsx scripts/db/verify-schema.ts",
    "cap:add:android": "npx cap add android",
    "cap:sync": "pnpm run cap:sync:prod",
    "cap:sync:prod": "./scripts/setup-capacitor-dev.sh",
    "cap:sync:emulator": "./scripts/setup-capacitor-dev.sh emulator",
    "cap:sync:device": "./scripts/setup-capacitor-dev.sh device",
    "cap:sync:device:wireless": "./scripts/setup-capacitor-dev.sh device-wireless",
    "cap:verify:prod": "node scripts/verify-capacitor-config.js",
    "cap:open:android": "npx cap open android",
    "build:mobile": "pnpm run cap:sync:prod && pnpm run cap:verify:prod",
    "android:assemble:release": "cd android && ./gradlew assembleRelease",
    "android:assemble:release:optimized": "cd android && MENTALA_ANDROID_ENABLE_MINIFY=true ./gradlew assembleRelease",
    "android:bundle:release": "cd android && ./gradlew bundleRelease",
    "android:bundle:release:optimized": "cd android && MENTALA_ANDROID_ENABLE_MINIFY=true ./gradlew prepareReleasePlayConsoleArtifacts",
    "build:mobile:android:release": "pnpm run cap:sync:prod && pnpm run cap:verify:prod && pnpm run android:bundle:release",
    "build:mobile:android:prod": "pnpm run cap:sync:prod && pnpm run cap:verify:prod && pnpm run android:bundle:release:optimized",
    "upload:media": "bash scripts/upload-media-safe.sh",
    "hash:notification-images": "node scripts/hash-notification-images.mjs",
    "upload:notification-images": "bash scripts/upload-notification-images.sh",
    "upload:media:legacy": "aws s3 sync public/meditations s3://mentala/meditations --endpoint-url=https://storage.yandexcloud.net --acl public-read --exclude \"*.DS_Store\" --exclude \"**/.DS_Store\" --delete",
    "cleanup:incomplete-uploads": "bash scripts/cleanup-incomplete-uploads.sh"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "7.1.6",
    "@aws-sdk/client-s3": "^3.1006.0",
    "@capacitor-community/fcm": "^7.1.3",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/clipboard": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/device": "^7.0.5",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/inappbrowser": "^2.5.4",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/local-notifications": "^7.0.3",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/privacy-screen": "1.1.4",
    "@capacitor/push-notifications": "^7.0.3",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@capgo/capacitor-native-biometric": "7.6.0",
    "@capgo/capacitor-social-login": "7.20.0",
    "@iconify-json/lucide": "^1.2.68",
    "@internationalized/date": "3.9.0",
    "@mediagrid/capacitor-native-audio": "2.3.2",
    "@noble/hashes": "^1.8.0",
    "@nuxtjs/tailwindcss": "6.14.0",
    "@radix-icons/vue": "^1.0.0",
    "@sentry/node": "^10.15.0",
    "@sentry/vue": "^10.15.0",
    "@tailwindcss/vite": "^4.1.13",
    "@vee-validate/zod": "^4.15.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^13.9.0",
    "@vueuse/nuxt": "^13.9.0",
    "argon2": "^0.40.1",
    "bullmq": "^5.65.1",
    "capacitor-native-settings": "^7.0.2",
    "chart.js": "^4.5.0",
    "clsx": "^2.1.1",
    "date-fns-tz": "^3.0.0",
    "driver.js": "^1.4.0",
    "drizzle-orm": "^0.44.6",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.6.0",
    "floating-vue": "^5.2.2",
    "google-auth-library": "^9.15.0",
    "gsap": "^3.14.2",
    "howler": "^2.2.4",
    "ioredis": "^5.8.2",
    "livekit-client": "^2.15.8",
    "lodash": "^4.17.21",
    "marked": "^17.0.1",
    "nanoid": "^5.1.6",
    "nodemailer": "^6.9.14",
    "nuxt": "^4.1.2",
    "ofetch": "^1.4.1",
    "ogl": "^1.0.11",
    "openai": "^4.104.0",
    "pg": "^8.12.0",
    "photoswipe": "^5.4.4",
    "pinia": "^3.0.3",
    "pino": "^9.12.0",
    "reka-ui": "^2.6.0",
    "shadcn-vue": "^2.2.0",
    "sharp": "^0.34.5",
    "swiper": "^12.1.1",
    "tailwindcss": "^4.1.13",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.21",
    "vue-chartjs": "^5.3.2",
    "vue-i18n": "^11.1.12",
    "vue-input-otp": "0.3.2",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@iconify-json/logos": "^1.2.9",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.54",
    "@nuxt/test-utils": "3.14.4",
    "@nuxtjs/eslint-config-typescript": "12.1.0",
    "@playwright/test": "1.48.2",
    "@rushstack/eslint-patch": "^1.15.0",
    "@scalar/nuxt": "^0.5.19",
    "@sentry/vite-plugin": "2.22.1",
    "@types/howler": "^2.2.12",
    "@types/lodash": "^4.17.20",
    "@types/marked": "^6.0.0",
    "@types/nodemailer": "^7.0.10",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "8.11.0",
    "@typescript-eslint/parser": "8.11.0",
    "@vitest/coverage-v8": "2.1.3",
    "@vitest/ui": "2.1.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "2.4.6",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "cz-git": "1.9.4",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-vue": "9.28.0",
    "husky": "9.1.6",
    "jsdom": "24.1.3",
    "lint-staged": "15.2.9",
    "nuxt-yandex-metrika": "^2.0.2",
    "openapi-typescript": "^7.4.0",
    "playwright": "1.48.2",
    "postcss": "^8.5.6",
    "prettier": "3.3.3",
    "radix-vue": "^1.9.17",
    "shadcn-nuxt": "2.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "5.6.3",
    "unplugin-icons": "^22.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-svg-loader": "^5.1.0",
    "vitest": "2.1.3",
    "workbox-precaching": "^7.4.0",
    "zod-to-openapi": "^0.2.1"
  },
  "lint-staged": {
    "*.{js,ts,vue,css,md}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@internationalized/date": "3.9.0",
      "on-change": "6.0.2"
    },
    "patchedDependencies": {
      "@capgo/capacitor-social-login@7.20.0": "patches/@capgo__capacitor-social-login@7.20.0.patch",
      "@mediagrid/capacitor-native-audio@2.3.2": "patches/@mediagrid__capacitor-native-audio@2.3.2.patch",
      "@capacitor-community/speech-recognition@7.0.1": "patches/@capacitor-community__speech-recognition@7.0.1.patch"
    }
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  }
}
