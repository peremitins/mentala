{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "pnpm dev:redis:up && ./scripts/wait-for-redis.sh && nuxt dev --dotenv .env.development --host 0.0.0.0 --port 3000",
    "dev:redis:up": "./scripts/start-redis.sh",
    "dev:redis:down": "docker compose -f docker-compose.dev.yml down redis",
    "dev:redis:logs": "docker compose -f docker-compose.dev.yml logs -f redis",
    "dev:redis:restart": "docker compose -f docker-compose.dev.yml restart redis",
    "dev:redis:check": "docker compose -f docker-compose.dev.yml exec -T redis redis-cli ping 2>/dev/null || redis-cli ping 2>/dev/null || echo '❌ Redis не запущен. Запусти: pnpm dev:redis:up или brew services start redis'",
    "dev:redis:stop-brew": "brew services stop redis 2>/dev/null || echo '⚠️  Redis не запущен через brew или brew недоступен'",
    "generate": "nuxt generate --dotenv .env.development",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:subscription-plans": "tsx server/infrastructure/db/seed-subscription-plans.ts",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync && node scripts/fix-capacitor-config.js",
    "cap:sync:emulator": "./scripts/setup-capacitor-dev.sh emulator",
    "cap:sync:device": "./scripts/setup-capacitor-dev.sh device",
    "cap:open:android": "npx cap open android",
    "build:mobile": "nuxt generate && npx cap sync"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/clipboard": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/local-notifications": "^7.0.3",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/push-notifications": "^7.0.3",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@iconify-json/lucide": "^1.2.68",
    "@capgo/capacitor-social-login": "^8.2.5",
    "@nuxtjs/tailwindcss": "6.14.0",
    "@radix-icons/vue": "^1.0.0",
    "@sentry/node": "^10.15.0",
    "@sentry/vue": "^10.15.0",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/vue-query": "^5.90.2",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^13.9.0",
    "@vueuse/nuxt": "^13.9.0",
    "argon2": "^0.40.1",
    "bullmq": "^5.65.1",
    "chart.js": "^4.5.0",
    "clsx": "^2.1.1",
    "date-fns-tz": "^3.0.0",
    "drizzle-orm": "^0.44.6",
    "firebase-admin": "^13.6.0",
    "floating-vue": "^5.2.2",
    "google-auth-library": "^9.15.0",
    "howler": "^2.2.4",
    "ioredis": "^5.8.2",
    "livekit-client": "^2.15.8",
    "lodash": "^4.17.21",
    "nanoid": "^5.1.6",
    "nodemailer": "^6.9.14",
    "nuxt": "^4.1.2",
    "ofetch": "^1.4.1",
    "ogl": "^1.0.11",
    "openai": "^4.104.0",
    "pg": "^8.12.0",
    "pinia": "^3.0.3",
    "pino": "^9.12.0",
    "reka-ui": "^2.6.0",
    "shadcn-vue": "^2.2.0",
    "tailwindcss": "^4.1.13",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.21",
    "vue-chartjs": "^5.3.2",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.8"
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@iconify-json/logos": "^1.2.9",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.54",
    "@nuxt/test-utils": "3.14.4",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/eslint-config-typescript": "12.1.0",
    "@playwright/test": "1.48.2",
    "@rushstack/eslint-patch": "^1.15.0",
    "@scalar/nuxt": "^0.5.19",
    "@sentry/vite-plugin": "2.22.1",
    "@types/lodash": "^4.17.20",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "8.11.0",
    "@typescript-eslint/parser": "8.11.0",
    "@vitest/coverage-v8": "2.1.3",
    "@vitest/ui": "2.1.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "2.4.6",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "cz-git": "1.9.4",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-vue": "9.28.0",
    "husky": "9.1.6",
    "jsdom": "24.1.3",
    "lint-staged": "15.2.9",
    "openapi-typescript": "^7.4.0",
    "playwright": "1.48.2",
    "postcss": "^8.5.6",
    "prettier": "3.3.3",
    "radix-vue": "^1.9.17",
    "shadcn-nuxt": "2.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "5.6.3",
    "unplugin-icons": "^22.3.0",
    "vitest": "2.1.3",
    "zod-to-openapi": "^0.2.1"
  },
  "lint-staged": {
    "*.{js,ts,vue,css,md}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  }
}
