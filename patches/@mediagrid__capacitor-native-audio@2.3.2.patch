@@ -0,0 +1,415 @@
+import Foundation
+
+public final class BreathingSessionController {
+    private static let cueFadeOutMs = 180
+    private static let cueFadeSteps = 6
+
+    private weak var pluginOwner: AudioPlayerPlugin?
+    private var config: BreathingSessionConfig?
+    private var phaseAdvanceWorkItem: DispatchWorkItem?
+    private var sessionStopWorkItem: DispatchWorkItem?
+    private var cueFadeWorkItems: [DispatchWorkItem] = []
+    private var primaryAudioId: String?
+    private var secondaryAudioId: String?
+    private var primaryUsesCue = false
+    private var primaryUsesVoice = false
+    private var secondaryUsesVoice = false
+    private var active = false
+    private var paused = false
+    private var startedAtMs = 0
+    private var pausedAtMs = 0
+    private var totalPausedMs = 0
+    private var phaseStartedAtMs = 0
+    private var currentPhaseIndex = 0
+
+    init(pluginOwner: AudioPlayerPlugin) {
+        self.pluginOwner = pluginOwner
+    }
+
+    func isActive() -> Bool {
+        active
+    }
+
+    func isPaused() -> Bool {
+        paused
+    }
+
+    func getConfig() -> BreathingSessionConfig? {
+        config
+    }
+
+    func start(_ config: BreathingSessionConfig) throws {
+        try stop()
+
+        self.config = config
+        active = true
+        paused = false
+        startedAtMs = nowMs()
+        pausedAtMs = 0
+        totalPausedMs = 0
+        currentPhaseIndex = 0
+        phaseStartedAtMs = startedAtMs
+
+        try applyCurrentPhase(recreateSources: true)
+        schedulePhaseAdvance()
+        scheduleSessionStop()
+    }
+
+    func pause() throws {
+        guard active, !paused else { return }
+        cancelPhaseAdvance()
+        cancelSessionStop()
+        cancelCueFadeOut()
+        paused = true
+        pausedAtMs = nowMs()
+        try pauseCurrentPhase()
+    }
+
+    func resume() throws {
+        guard active, paused, config != nil else { return }
+        let pausedDurationMs = max(0, nowMs() - pausedAtMs)
+        totalPausedMs += pausedDurationMs
+        phaseStartedAtMs += pausedDurationMs
+        paused = false
+        pausedAtMs = 0
+        try resumeCurrentPhase()
+        scheduleCueFadeOut()
+        schedulePhaseAdvance()
+        scheduleSessionStop()
+    }
+
+    func update(_ nextConfig: BreathingSessionConfig) throws {
+        config = nextConfig
+        guard active else { return }
+        scheduleSessionStop()
+        try applyCurrentPhaseConfig()
+        scheduleCueFadeOut()
+    }
+
+    func stop() throws {
+        cancelPhaseAdvance()
+        cancelSessionStop()
+        cancelCueFadeOut()
+        try stopCurrentPhase()
+        config = nil
+        active = false
+        paused = false
+        startedAtMs = 0
+        pausedAtMs = 0
+        totalPausedMs = 0
+        phaseStartedAtMs = 0
+        currentPhaseIndex = 0
+    }
+
+    private func getRemainingPhaseMs() -> Int {
+        guard let config, !config.phases.isEmpty else { return 0 }
+        let phase = config.phases[currentPhaseIndex]
+        let elapsedPhaseMs = max(0, nowMs() - phaseStartedAtMs)
+        return max(0, phase.durationMs - elapsedPhaseMs)
+    }
+
+    private func schedulePhaseAdvance() {
+        cancelPhaseAdvance()
+        guard active, !paused, let config, !config.phases.isEmpty else { return }
+
+        let workItem = DispatchWorkItem { [weak self] in
+            guard let self, self.active, !self.paused, let config = self.config, !config.phases.isEmpty
+            else {
+                return
+            }
+
+            var advanced = false
+            var safetyCounter = 0
+
+            while safetyCounter < config.phases.count {
+                let currentPhase = config.phases[self.currentPhaseIndex]
+                let currentPhaseEndsAtMs = self.phaseStartedAtMs + currentPhase.durationMs
+                if self.nowMs() < currentPhaseEndsAtMs {
+                    break
+                }
+
+                self.phaseStartedAtMs = currentPhaseEndsAtMs
+                self.currentPhaseIndex = (self.currentPhaseIndex + 1) % config.phases.count
+                advanced = true
+                safetyCounter += 1
+            }
+
+            if !advanced {
+                self.schedulePhaseAdvance()
+                return
+            }
+
+            do {
+                try self.applyCurrentPhase(recreateSources: false)
+                self.schedulePhaseAdvance()
+            } catch {
+            }
+        }
+
+        phaseAdvanceWorkItem = workItem
+        DispatchQueue.main.asyncAfter(
+            deadline: .now() + .milliseconds(max(0, getRemainingPhaseMs())),
+            execute: workItem
+        )
+    }
+
+    private func cancelPhaseAdvance() {
+        phaseAdvanceWorkItem?.cancel()
+        phaseAdvanceWorkItem = nil
+    }
+
+    private func scheduleSessionStop() {
+        cancelSessionStop()
+        guard active, let config, let sessionEndsAtMs = config.sessionEndsAtMs else { return }
+
+        let workItem = DispatchWorkItem { [weak self] in
+            try? self?.stop()
+        }
+
+        sessionStopWorkItem = workItem
+        DispatchQueue.main.asyncAfter(
+            deadline: .now() + .milliseconds(max(0, sessionEndsAtMs - nowMs())),
+            execute: workItem
+        )
+    }
+
+    private func cancelSessionStop() {
+        sessionStopWorkItem?.cancel()
+        sessionStopWorkItem = nil
+    }
+
+    private func scheduleCueFadeOut() {
+        cancelCueFadeOut()
+        guard active, !paused, let pluginOwner, let config, primaryUsesCue, config.soundEnabled,
+              config.cueVolume > 0,
+              let primaryAudioId
+        else {
+            return
+        }
+
+        let remainingPhaseMs = getRemainingPhaseMs()
+        guard remainingPhaseMs > 0 else { return }
+
+        let fadeDurationMs = min(Self.cueFadeOutMs, remainingPhaseMs)
+        let fadeDelayMs = max(0, remainingPhaseMs - fadeDurationMs)
+        let phaseIndexSnapshot = currentPhaseIndex
+        let phaseStartedAtSnapshot = phaseStartedAtMs
+        let startVolume = config.cueVolume
+
+        for step in 1 ... Self.cueFadeSteps {
+            let progress = Float(step) / Float(Self.cueFadeSteps)
+            let stepDelayMs = fadeDelayMs + Int(
+                (Double(fadeDurationMs) * Double(step)) / Double(Self.cueFadeSteps)
+            )
+            let workItem = DispatchWorkItem { [weak self] in
+                guard let self,
+                      self.active,
+                      !self.paused,
+                      self.primaryUsesCue,
+                      self.currentPhaseIndex == phaseIndexSnapshot,
+                      self.phaseStartedAtMs == phaseStartedAtSnapshot,
+                      self.primaryAudioId == primaryAudioId
+                else {
+                    return
+                }
+
+                let nextVolume = max(0, startVolume * (1 - progress))
+                try? pluginOwner.setManagedAudioSourceVolume(
+                    audioId: primaryAudioId,
+                    volume: nextVolume
+                )
+            }
+
+            cueFadeWorkItems.append(workItem)
+            DispatchQueue.main.asyncAfter(
+                deadline: .now() + .milliseconds(max(0, stepDelayMs)),
+                execute: workItem
+            )
+        }
+    }
+
+    private func cancelCueFadeOut() {
+        cueFadeWorkItems.forEach { $0.cancel() }
+        cueFadeWorkItems.removeAll()
+    }
+
+    private func applyCurrentPhase(recreateSources: Bool) throws {
+        guard let pluginOwner, let config, !config.phases.isEmpty else {
+            try stopCurrentPhase()
+            return
+        }
+
+        cancelCueFadeOut()
+        let phase = config.phases[currentPhaseIndex]
+        let hasCuePrimary =
+            !(phase.cueAudioSource?.isEmpty ?? true)
+        let wantsVoicePrimary =
+            !hasCuePrimary &&
+            config.voiceEnabled &&
+            !(phase.voiceAudioSource?.isEmpty ?? true)
+        let wantsSecondaryVoice =
+            hasCuePrimary &&
+            config.voiceEnabled &&
+            !(phase.voiceAudioSource?.isEmpty ?? true)
+
+        if !hasCuePrimary, !wantsVoicePrimary {
+            try clearPrimary()
+        }
+
+        if !wantsSecondaryVoice {
+            try clearSecondary()
+        }
+
+        if hasCuePrimary, let cueAudioSource = phase.cueAudioSource {
+            primaryAudioId = "\(config.sessionId)_primary"
+            if recreateSources || !primaryUsesCue || primaryAudioId == nil {
+                try pluginOwner.createOrReplaceManagedAudioSource(
+                    audioId: primaryAudioId!,
+                    source: cueAudioSource,
+                    friendlyTitle: phase.friendlyTitle,
+                    useForNotification: true,
+                    loop: true,
+                    volume: config.soundEnabled ? config.cueVolume : 0
+                )
+            } else {
+                try pluginOwner.changeManagedAudioSource(
+                    audioId: primaryAudioId!,
+                    source: cueAudioSource
+                )
+                try pluginOwner.setManagedAudioSourceVolume(
+                    audioId: primaryAudioId!,
+                    volume: config.soundEnabled ? config.cueVolume : 0
+                )
+            }
+            try pluginOwner.playManagedAudioSource(audioId: primaryAudioId!)
+            primaryUsesCue = true
+            primaryUsesVoice = false
+        } else if wantsVoicePrimary, let voiceAudioSource = phase.voiceAudioSource {
+            primaryAudioId = "\(config.sessionId)_primary"
+            if recreateSources || !primaryUsesVoice || primaryAudioId == nil {
+                try pluginOwner.createOrReplaceManagedAudioSource(
+                    audioId: primaryAudioId!,
+                    source: voiceAudioSource,
+                    friendlyTitle: phase.friendlyTitle,
+                    useForNotification: true,
+                    loop: false,
+                    volume: 1
+                )
+            } else {
+                try pluginOwner.changeManagedAudioSource(
+                    audioId: primaryAudioId!,
+                    source: voiceAudioSource
+                )
+            }
+            try pluginOwner.playManagedAudioSource(audioId: primaryAudioId!)
+            primaryUsesCue = false
+            primaryUsesVoice = true
+        } else {
+            primaryUsesCue = false
+            primaryUsesVoice = false
+        }
+
+        if wantsSecondaryVoice, let voiceAudioSource = phase.voiceAudioSource {
+            secondaryAudioId = "\(config.sessionId)_secondary"
+            if recreateSources || secondaryAudioId == nil || !secondaryUsesVoice {
+                try pluginOwner.createOrReplaceManagedAudioSource(
+                    audioId: secondaryAudioId!,
+                    source: voiceAudioSource,
+                    friendlyTitle: phase.friendlyTitle,
+                    useForNotification: false,
+                    loop: false,
+                    volume: 1
+                )
+            } else {
+                try pluginOwner.changeManagedAudioSource(
+                    audioId: secondaryAudioId!,
+                    source: voiceAudioSource
+                )
+            }
+            try pluginOwner.playManagedAudioSource(audioId: secondaryAudioId!)
+            secondaryUsesVoice = true
+        }
+
+        scheduleCueFadeOut()
+    }
+
+    private func applyCurrentPhaseConfig() throws {
+        guard active, let pluginOwner, let config else { return }
+
+        if !config.soundEnabled, primaryUsesCue, let primaryAudioId {
+            try pluginOwner.setManagedAudioSourceVolume(
+                audioId: primaryAudioId,
+                volume: 0
+            )
+        }
+
+        if !config.voiceEnabled {
+            if secondaryUsesVoice, let secondaryAudioId {
+                try pluginOwner.stopAndDestroyManagedAudioSource(audioId: secondaryAudioId)
+                self.secondaryAudioId = nil
+                secondaryUsesVoice = false
+            }
+
+            if primaryUsesVoice, let primaryAudioId {
+                try pluginOwner.stopAndDestroyManagedAudioSource(audioId: primaryAudioId)
+                self.primaryAudioId = nil
+                primaryUsesVoice = false
+            }
+        }
+
+        if config.soundEnabled, primaryUsesCue, let primaryAudioId {
+            try pluginOwner.setManagedAudioSourceVolume(
+                audioId: primaryAudioId,
+                volume: config.cueVolume
+            )
+        }
+    }
+
+    private func pauseCurrentPhase() throws {
+        if let pluginOwner, let secondaryAudioId {
+            try pluginOwner.pauseManagedAudioSource(audioId: secondaryAudioId)
+        }
+
+        if let pluginOwner, let primaryAudioId {
+            try pluginOwner.pauseManagedAudioSource(audioId: primaryAudioId)
+        }
+    }
+
+    private func resumeCurrentPhase() throws {
+        if let pluginOwner, let primaryAudioId {
+            try pluginOwner.playManagedAudioSource(audioId: primaryAudioId)
+        }
+
+        if let pluginOwner, let secondaryAudioId {
+            try pluginOwner.playManagedAudioSource(audioId: secondaryAudioId)
+        }
+    }
+
+    private func stopCurrentPhase() throws {
+        try clearSecondary()
+        try clearPrimary()
+    }
+
+    private func clearPrimary() throws {
+        if let pluginOwner, let primaryAudioId {
+            try pluginOwner.stopAndDestroyManagedAudioSource(audioId: primaryAudioId)
+            self.primaryAudioId = nil
+        }
+
+        primaryUsesCue = false
+        primaryUsesVoice = false
+    }
+
+    private func clearSecondary() throws {
+        if let pluginOwner, let secondaryAudioId {
+            try pluginOwner.stopAndDestroyManagedAudioSource(audioId: secondaryAudioId)
+            self.secondaryAudioId = nil
+        }
+
+        secondaryUsesVoice = false
+    }
+
+    private func nowMs() -> Int {
+        Int(Date().timeIntervalSince1970 * 1000)
+    }
+}
