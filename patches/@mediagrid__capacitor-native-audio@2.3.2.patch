+
+    public BreathingSessionController(AudioPlayerPlugin plugin) {
+        this.plugin = plugin;
+    }
+
+    public boolean isActive() {
+        return active;
+    }
+
+    public boolean isPaused() {
+        return paused;
+    }
+
+    public BreathingSessionConfig getConfig() {
+        return config;
+    }
+
+    public void start(BreathingSessionConfig config) throws Exception {
+        stop();
+
+        this.config = config;
+        this.active = true;
+        this.paused = false;
+        this.startedAtMs = System.currentTimeMillis();
+        this.pausedAtMs = 0;
+        this.totalPausedMs = 0;
+        this.currentPhaseIndex = 0;
+        this.phaseStartedAtMs = this.startedAtMs;
+
+        applyCurrentPhase(true);
+        schedulePhaseAdvance();
+        scheduleSessionStop();
+    }
+
+    public void pause() throws Exception {
+        if (!active || paused) {
+            return;
+        }
+
+        cancelPhaseAdvance();
+        cancelSessionStop();
+        cancelCueFadeOut();
+        paused = true;
+        pausedAtMs = System.currentTimeMillis();
+        pauseCurrentPhase();
+    }
+
+    public void resume() throws Exception {
+        if (!active || !paused || config == null) {
+            return;
+        }
+
+        long pausedDurationMs = Math.max(0, System.currentTimeMillis() - pausedAtMs);
+        totalPausedMs += pausedDurationMs;
+        phaseStartedAtMs += pausedDurationMs;
+        paused = false;
+        pausedAtMs = 0;
+        resumeCurrentPhase();
+        scheduleCueFadeOut();
+        schedulePhaseAdvance();
+        scheduleSessionStop();
+    }
+
+    public void update(BreathingSessionConfig nextConfig) throws Exception {
+        if (config == null) {
+            config = nextConfig;
+            return;
+        }
+
+        config = nextConfig;
+        if (!active) {
+            return;
+        }
+
+        scheduleSessionStop();
+        applyCurrentPhaseConfig();
+        scheduleCueFadeOut();
+    }
+
+    public void stop() throws Exception {
+        cancelPhaseAdvance();
+        cancelSessionStop();
+        cancelCueFadeOut();
+        stopCurrentPhase();
+        config = null;
+        active = false;
+        paused = false;
+        startedAtMs = 0;
+        pausedAtMs = 0;
+        totalPausedMs = 0;
+        phaseStartedAtMs = 0;
+        currentPhaseIndex = 0;
+    }
+
+    private long getRemainingPhaseMs() {
+        if (config == null || config.phases.isEmpty()) {
+            return 0;
+        }
+
+        BreathingPhaseConfig phase = config.phases.get(currentPhaseIndex);
+        long elapsedPhaseMs = Math.max(0, System.currentTimeMillis() - phaseStartedAtMs);
+        return Math.max(0, phase.durationMs - elapsedPhaseMs);
+    }
+
+    private void schedulePhaseAdvance() {
+        cancelPhaseAdvance();
+        if (!active || paused || config == null || config.phases.isEmpty()) {
+            return;
+        }
+
+        long delayMs = getRemainingPhaseMs();
+        phaseAdvanceRunnable = () -> {
+            if (!active || paused || config == null || config.phases.isEmpty()) {
+                return;
+            }
+
+            boolean advanced = false;
+            int safetyCounter = 0;
+
+            while (safetyCounter < config.phases.size()) {
+                BreathingPhaseConfig currentPhase = config.phases.get(currentPhaseIndex);
+                long currentPhaseEndsAtMs = phaseStartedAtMs + currentPhase.durationMs;
+                if (System.currentTimeMillis() < currentPhaseEndsAtMs) {
+                    break;
+                }
+
+                phaseStartedAtMs = currentPhaseEndsAtMs;
+                currentPhaseIndex = (currentPhaseIndex + 1) % config.phases.size();
+                advanced = true;
+                safetyCounter += 1;
+            }
+
+            if (!advanced) {
+                schedulePhaseAdvance();
+                return;
+            }
+
+            try {
+                applyCurrentPhase(false);
+                schedulePhaseAdvance();
+            } catch (Exception ignored) {
+            }
+        };
+
+        handler.postDelayed(phaseAdvanceRunnable, Math.max(0, delayMs));
+    }
+
+    private void cancelPhaseAdvance() {
+        if (phaseAdvanceRunnable == null) {
+            return;
+        }
+
+        handler.removeCallbacks(phaseAdvanceRunnable);
+        phaseAdvanceRunnable = null;
+    }
+
+    private void scheduleSessionStop() {
+        cancelSessionStop();
+        if (!active || config == null || config.sessionEndsAtMs == null) {
+            return;
+        }
+
+        long delayMs = Math.max(0, config.sessionEndsAtMs - System.currentTimeMillis());
+        sessionStopRunnable = () -> {
+            try {
+                stop();
+            } catch (Exception ignored) {
+            }
+        };
+
+        handler.postDelayed(sessionStopRunnable, delayMs);
+    }
+
+    private void cancelSessionStop() {
+        if (sessionStopRunnable == null) {
+            return;
+        }
+
+        handler.removeCallbacks(sessionStopRunnable);
+        sessionStopRunnable = null;
+    }
+
+    private void scheduleCueFadeOut() {
+        cancelCueFadeOut();
+        if (
+            !active ||
+            paused ||
+            config == null ||
+            !primaryUsesCue ||
+            !config.soundEnabled ||
+            config.cueVolume <= 0f ||
+            primaryAudioId == null
+        ) {
+            return;
+        }
+
+        final long remainingPhaseMs = getRemainingPhaseMs();
+        if (remainingPhaseMs <= 0) {
+            return;
+        }
+
+        final int fadeDurationMs = (int) Math.min(CUE_FADE_OUT_MS, remainingPhaseMs);
+        final long fadeDelayMs = Math.max(0, remainingPhaseMs - fadeDurationMs);
+        final int phaseIndexSnapshot = currentPhaseIndex;
+        final long phaseStartedAtSnapshot = phaseStartedAtMs;
+        final String primaryAudioIdSnapshot = primaryAudioId;
+        final float startVolume = config.cueVolume;
+
+        for (int step = 1; step <= CUE_FADE_STEPS; step += 1) {
+            final float progress = (float) step / (float) CUE_FADE_STEPS;
+            final long stepDelayMs =
+                fadeDelayMs + Math.round((float) fadeDurationMs * progress);
+
+            Runnable fadeRunnable = () -> {
+                if (
+                    !active ||
+                    paused ||
+                    !primaryUsesCue ||
+                    currentPhaseIndex != phaseIndexSnapshot ||
+                    phaseStartedAtMs != phaseStartedAtSnapshot ||
+                    primaryAudioId == null ||
+                    !primaryAudioId.equals(primaryAudioIdSnapshot)
+                ) {
+                    return;
+                }
+
+                float nextVolume = Math.max(0f, startVolume * (1f - progress));
+                try {
+                    plugin.setManagedAudioSourceVolume(primaryAudioIdSnapshot, nextVolume);
+                } catch (Exception ignored) {
+                }
+            };
+
+            cueFadeRunnables.add(fadeRunnable);
+            handler.postDelayed(fadeRunnable, Math.max(0, stepDelayMs));
+        }
+    }
+
+    private void cancelCueFadeOut() {
+        if (cueFadeRunnables.isEmpty()) {
+            return;
+        }
+
+        for (Runnable runnable : cueFadeRunnables) {
+            handler.removeCallbacks(runnable);
+        }
+        cueFadeRunnables.clear();
+    }
+
+    private void applyCurrentPhase(boolean recreateSources) throws Exception {
+        if (config == null || config.phases.isEmpty()) {
+            stopCurrentPhase();
+            return;
+        }
+
+        cancelCueFadeOut();
+        BreathingPhaseConfig phase = config.phases.get(currentPhaseIndex);
+        Log.i(
+            TAG,
+            String.format(
+                "Applying phase %s (%d/%d), sound=%s, voice=%s",
+                phase.phaseType,
+                currentPhaseIndex + 1,
+                config.phases.size(),
+                config.soundEnabled,
+                config.voiceEnabled
+            )
+        );
+
+        boolean hasCuePrimary =
+            phase.cueAudioSource != null &&
+            !phase.cueAudioSource.isEmpty();
+        boolean wantsVoicePrimary =
+            !hasCuePrimary &&
+            config.voiceEnabled &&
+            phase.voiceAudioSource != null &&
+            !phase.voiceAudioSource.isEmpty();
+        boolean wantsSecondaryVoice =
+            hasCuePrimary &&
+            config.voiceEnabled &&
+            phase.voiceAudioSource != null &&
+            !phase.voiceAudioSource.isEmpty();
+
+        if (!hasCuePrimary && !wantsVoicePrimary) {
+            clearPrimary();
+        }
+
+        if (!wantsSecondaryVoice) {
+            clearSecondary();
+        }
+
+        if (hasCuePrimary) {
+            primaryAudioId = config.sessionId + "_primary";
+            if (recreateSources || !primaryUsesCue || primaryAudioId == null) {
+                plugin.createOrReplaceManagedAudioSource(
+                    primaryAudioId,
+                    phase.cueAudioSource,
+                    phase.friendlyTitle,
+                    true,
+                    true,
+                    config.soundEnabled ? config.cueVolume : 0f
+                );
+            } else {
+                plugin.changeManagedAudioSource(primaryAudioId, phase.cueAudioSource);
+                plugin.setManagedAudioSourceVolume(
+                    primaryAudioId,
+                    config.soundEnabled ? config.cueVolume : 0f
+                );
+            }
+            plugin.playManagedAudioSource(primaryAudioId);
+            primaryUsesCue = true;
+            primaryUsesVoice = false;
+        } else if (wantsVoicePrimary) {
+            primaryAudioId = config.sessionId + "_primary";
+            if (recreateSources || !primaryUsesVoice || primaryAudioId == null) {
+                plugin.createOrReplaceManagedAudioSource(
+                    primaryAudioId,
+                    phase.voiceAudioSource,
+                    phase.friendlyTitle,
+                    true,
+                    false,
+                    1f
+                );
+            } else {
+                plugin.changeManagedAudioSource(primaryAudioId, phase.voiceAudioSource);
+            }
+            plugin.playManagedAudioSource(primaryAudioId);
+            primaryUsesCue = false;
+            primaryUsesVoice = true;
+        } else {
+            primaryUsesCue = false;
+            primaryUsesVoice = false;
+        }
+
+        if (wantsSecondaryVoice) {
+            secondaryAudioId = config.sessionId + "_secondary";
+            if (recreateSources || secondaryAudioId == null || !secondaryUsesVoice) {
+                plugin.createOrReplaceManagedAudioSource(
+                    secondaryAudioId,
+                    phase.voiceAudioSource,
+                    phase.friendlyTitle,
+                    false,
+                    false,
+                    1f
+                );
+            } else {
+                plugin.changeManagedAudioSource(secondaryAudioId, phase.voiceAudioSource);
+            }
+            plugin.playManagedAudioSource(secondaryAudioId);
+            secondaryUsesVoice = true;
+        } else {
+            secondaryUsesVoice = false;
+        }
+
+        scheduleCueFadeOut();
+    }
+
+    private void applyCurrentPhaseConfig() throws Exception {
+        if (!active || config == null) {
+            return;
+        }
+
+        if (!config.soundEnabled && primaryUsesCue && primaryAudioId != null) {
+            plugin.setManagedAudioSourceVolume(primaryAudioId, 0f);
+        }
+
+        if (!config.voiceEnabled) {
+            if (secondaryUsesVoice && secondaryAudioId != null) {
+                plugin.stopAndDestroyManagedAudioSource(secondaryAudioId);
+                secondaryAudioId = null;
+                secondaryUsesVoice = false;
+            }
+
+            if (primaryUsesVoice && primaryAudioId != null) {
+                plugin.stopAndDestroyManagedAudioSource(primaryAudioId);
+                primaryAudioId = null;
+                primaryUsesVoice = false;
+            }
+        }
+
+        if (config.soundEnabled && primaryUsesCue && primaryAudioId != null) {
+            plugin.setManagedAudioSourceVolume(primaryAudioId, config.cueVolume);
+        }
+    }
+
+    private void pauseCurrentPhase() throws Exception {
+        if (secondaryAudioId != null) {
+            plugin.pauseManagedAudioSource(secondaryAudioId);
+        }
+
+        if (primaryAudioId != null) {
+            plugin.pauseManagedAudioSource(primaryAudioId);
+        }
+    }
+
+    private void resumeCurrentPhase() throws Exception {
+        if (primaryAudioId != null) {
+            plugin.playManagedAudioSource(primaryAudioId);
+        }
+
+        if (secondaryAudioId != null) {
+            plugin.playManagedAudioSource(secondaryAudioId);
+        }
+    }
+
+    private void stopCurrentPhase() throws Exception {
+        clearSecondary();
+        clearPrimary();
+    }
+
+    private void clearPrimary() throws Exception {
+        if (primaryAudioId != null) {
+            plugin.stopAndDestroyManagedAudioSource(primaryAudioId);
+            primaryAudioId = null;
+        }
+
+        primaryUsesCue = false;
+        primaryUsesVoice = false;
+    }
+
+    private void clearSecondary() throws Exception {
+        if (secondaryAudioId != null) {
+            plugin.stopAndDestroyManagedAudioSource(secondaryAudioId);
+            secondaryAudioId = null;
+        }
+
+        secondaryUsesVoice = false;
+    }
+}
