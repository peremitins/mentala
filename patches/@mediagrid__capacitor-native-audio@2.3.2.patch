@@ -0,0 +1,68 @@
+import Capacitor
+import Foundation
+
+public struct BreathingSessionConfig {
+    let sessionId: String
+    let phases: [BreathingPhaseConfig]
+    let soundEnabled: Bool
+    let voiceEnabled: Bool
+    let cueVolume: Float
+    let sessionEndsAtMs: Int?
+
+    func copyWith(
+        soundEnabled: Bool?,
+        voiceEnabled: Bool?,
+        cueVolume: Float?,
+        sessionEndsAtMs: Int?
+    ) -> BreathingSessionConfig {
+        BreathingSessionConfig(
+            sessionId: sessionId,
+            phases: phases,
+            soundEnabled: soundEnabled ?? self.soundEnabled,
+            voiceEnabled: voiceEnabled ?? self.voiceEnabled,
+            cueVolume: cueVolume ?? self.cueVolume,
+            sessionEndsAtMs: sessionEndsAtMs ?? self.sessionEndsAtMs
+        )
+    }
+
+    static func fromCall(_ call: CAPPluginCall) throws -> BreathingSessionConfig {
+        guard let sessionId = call.getString("sessionId"), !sessionId.isEmpty else {
+            throw AudioPlayerError.runtimeError("Missing breathing sessionId.")
+        }
+
+        let rawPhases = (call.getArray("phases") ?? []).compactMap {
+            $0 as? [String: Any]
+        }
+
+        guard
+              !rawPhases.isEmpty
+        else {
+            throw AudioPlayerError.runtimeError("Missing breathing phases.")
+        }
+
+        let phases = rawPhases.enumerated().map { index, phase in
+            BreathingPhaseConfig(
+                phaseId: (phase["phaseId"] as? String) ?? "phase_\(index)",
+                phaseType: (phase["phaseType"] as? String) ?? "",
+                cueType: (phase["cueType"] as? String) ?? "",
+                durationMs: max(0, (phase["durationMs"] as? Int) ?? 0),
+                cueAudioSource: phase["cueAudioSource"] as? String,
+                voiceAudioSource: phase["voiceAudioSource"] as? String,
+                friendlyTitle: (phase["friendlyTitle"] as? String) ?? "Breathing"
+            )
+        }
+
+        let rawEndsAt = call.getDouble("sessionEndsAtMs")
+
+        return BreathingSessionConfig(
+            sessionId: sessionId,
+            phases: phases,
+            soundEnabled: call.getBool("soundEnabled", false),
+            voiceEnabled: call.getBool("voiceEnabled", false),
+            cueVolume: Float(call.getFloat("cueVolume", 1)),
+            sessionEndsAtMs: rawEndsAt == nil || rawEndsAt! <= 0
+                ? nil
+                : Int(rawEndsAt!)
+        )
+    }
+}
