@@ -0,0 +1,90 @@
+package us.mediagrid.capacitorjs.plugins.nativeaudio;
+
+import com.getcapacitor.JSArray;
+import com.getcapacitor.PluginCall;
+import java.util.ArrayList;
+import java.util.List;
+import org.json.JSONObject;
+
+public class BreathingSessionConfig {
+
+    public final String sessionId;
+    public final List<BreathingPhaseConfig> phases;
+    public final boolean soundEnabled;
+    public final boolean voiceEnabled;
+    public final float cueVolume;
+    public final Long sessionEndsAtMs;
+
+    public BreathingSessionConfig(
+        String sessionId,
+        List<BreathingPhaseConfig> phases,
+        boolean soundEnabled,
+        boolean voiceEnabled,
+        float cueVolume,
+        Long sessionEndsAtMs
+    ) {
+        this.sessionId = sessionId;
+        this.phases = phases;
+        this.soundEnabled = soundEnabled;
+        this.voiceEnabled = voiceEnabled;
+        this.cueVolume = cueVolume;
+        this.sessionEndsAtMs = sessionEndsAtMs;
+    }
+
+    public static BreathingSessionConfig fromCall(PluginCall call) throws Exception {
+        String sessionId = call.getString("sessionId");
+        if (sessionId == null || sessionId.isEmpty()) {
+            throw new RuntimeException("Missing breathing sessionId.");
+        }
+
+        JSArray phasesArray = call.getArray("phases");
+        if (phasesArray == null || phasesArray.length() == 0) {
+            throw new RuntimeException("Missing breathing phases.");
+        }
+
+        List<BreathingPhaseConfig> phases = new ArrayList<>();
+        for (int index = 0; index < phasesArray.length(); index += 1) {
+            JSONObject phase = phasesArray.getJSONObject(index);
+            phases.add(
+                new BreathingPhaseConfig(
+                    phase.optString("phaseId", "phase_" + index),
+                    phase.optString("phaseType", ""),
+                    phase.optString("cueType", ""),
+                    Math.max(0, phase.optInt("durationMs", 0)),
+                    phase.has("cueAudioSource") ? phase.optString("cueAudioSource", null) : null,
+                    phase.has("voiceAudioSource")
+                        ? phase.optString("voiceAudioSource", null)
+                        : null,
+                    phase.optString("friendlyTitle", "Breathing")
+                )
+            );
+        }
+
+        Long sessionEndsAtMs = call.getLong("sessionEndsAtMs");
+
+        return new BreathingSessionConfig(
+            sessionId,
+            phases,
+            call.getBoolean("soundEnabled", false),
+            call.getBoolean("voiceEnabled", false),
+            call.getFloat("cueVolume", 1f),
+            sessionEndsAtMs == null || sessionEndsAtMs <= 0 ? null : sessionEndsAtMs
+        );
+    }
+
+    public BreathingSessionConfig copyWith(
+        Boolean soundEnabled,
+        Boolean voiceEnabled,
+        Float cueVolume,
+        Long sessionEndsAtMs
+    ) {
+        return new BreathingSessionConfig(
+            sessionId,
+            phases,
+            soundEnabled == null ? this.soundEnabled : soundEnabled,
+            voiceEnabled == null ? this.voiceEnabled : voiceEnabled,
+            cueVolume == null ? this.cueVolume : cueVolume,
+            sessionEndsAtMs == null ? this.sessionEndsAtMs : sessionEndsAtMs
+        );
+    }
+}
