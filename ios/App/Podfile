target 'App' do
  capacitor_pods
  # Add your Pods here
end

target 'MentalaNotificationService' do
  # Firebase helper для автоматического прикрепления rich image в iOS push.
  pod 'Firebase/Messaging'
end

post_install do |installer|
  assertDeploymentTarget(installer)
end
