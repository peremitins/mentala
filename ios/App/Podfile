  pod 'CapgoCapacitorSocialLogin', :path => '../../node_modules/.pnpm/@capgo+capacitor-social-login@7.20.0_patch_hash=494f63e7b7f9e31eb1bfe9f162a2ac49a717948_09f6fb5a1db32fd44b4bf5e71e6fb80f/node_modules/@capgo/capacitor-social-login'
  pod 'MediagridCapacitorNativeAudio', :path => '../../node_modules/.pnpm/@mediagrid+capacitor-native-audio@2.3.2_patch_hash=4bc2c25b48894d417cf89e3b3a800acb5a24_4ad0ca218fac7cdc2cafef4a7b717307/node_modules/@mediagrid/capacitor-native-audio'
