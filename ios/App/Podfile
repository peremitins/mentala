  pod 'CapgoCapacitorSocialLogin', :path => '../../node_modules/.pnpm/@capgo+capacitor-social-login@7.20.0_patch_hash=494f63e7b7f9e31eb1bfe9f162a2ac49a717948_09f6fb5a1db32fd44b4bf5e71e6fb80f/node_modules/@capgo/capacitor-social-login'
  pod 'MediagridCapacitorNativeAudio', :path => '../../node_modules/.pnpm/@mediagrid+capacitor-native-audio@2.3.2_patch_hash=f0855946516e081a94cdea8ee9a8d37e3a72_4a210e8793d92ba283af67eff2b6d577/node_modules/@mediagrid/capacitor-native-audio'
