[Unit]
Description=Mentala Disk Guard (monitor + prune + telegram)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root

Environment=DISK_MOUNT=/
Environment=WARN_PCT=85
Environment=CRIT_PCT=92
Environment=WARN_PRUNE_HOURS=72
Environment=CRIT_PRUNE_HOURS=168
Environment=WARN_REPEAT_MINUTES=60
Environment=CRIT_REPEAT_MINUTES=10

EnvironmentFile=/etc/mentala/telegram.env

ExecStart=/usr/local/bin/mentala-disk-guard.sh

TimeoutStartSec=900

StandardOutput=journal
StandardError=journal
