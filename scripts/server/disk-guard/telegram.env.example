# Скопировать на сервер в /etc/mentala/telegram.env (mode 600, root:root) и заполнить.
# Файл с РЕАЛЬНЫМИ значениями НЕ КОММИТИТЬ!
#
# Чтобы получить chat_id: добавить бота в чат, написать /start, открыть
# https://api.telegram.org/bot<TOKEN>/getUpdates — там будет chat.id.
# Для треда в супергруппе: переслать сообщение из нужного треда боту, посмотреть
# message_thread_id в getUpdates.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Опционально: id треда (топика) в супергруппе. Если бот пишет в обычный чат — оставить пустым.
TELEGRAM_THREAD_ID=
